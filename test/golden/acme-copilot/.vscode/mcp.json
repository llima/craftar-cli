{
  "servers": {
    "api": {
      "command": "npx",
      "args": [
        "${workspaceFolder}/api"
      ],
      "env": {
        "TOKEN": "${env:API_TOKEN}"
      }
    },
    "remote": {
      "type": "http",
      "url": "https://example.com/mcp",
      "headers": {
        "X-Key": "${env:KEY}"
      }
    }
  }
}
